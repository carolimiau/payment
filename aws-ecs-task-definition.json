{
  "family": "autobox-payment-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "payment-service",
      "image": "<ECR_REPOSITORY_URI>:latest",
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "TBK_ENV",
          "value": "PRODUCTION"
        },
        {
          "name": "PORT",
          "value": "3001"
        }
      ],
      "secrets": [
        {
          "name": "TBK_COMMERCE_CODE",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/TBK_COMMERCE_CODE"
        },
        {
          "name": "TBK_API_KEY_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/TBK_API_KEY_SECRET"
        },
        {
          "name": "MYSQLHOST",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/MYSQLHOST"
        },
        {
          "name": "MYSQLPORT",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/MYSQLPORT"
        },
        {
          "name": "MYSQLUSER",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/MYSQLUSER"
        },
        {
          "name": "MYSQLPASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/MYSQLPASSWORD"
        },
        {
          "name": "MYSQLDATABASE",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/autobox/payment/MYSQLDATABASE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/autobox-payment",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
